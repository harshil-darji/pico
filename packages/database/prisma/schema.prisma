generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bots      Bot[]
  memories  Memory[]
  computers Computer[]
  connectors Connector[]
}

model Bot {
  id                String         @id @default(cuid())
  userId            String
  name              String
  avatar            String?
  description       String?
  role              String?
  personality       String?
  systemInstructions String?
  preferredModel    String?
  reasoningLevel    String?
  workspacePath     String?
  memoryNamespace   String?
  approvalPolicy    Json?
  usageLimits       Json?
  notificationPrefs Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations     Conversation[]
  memories          Memory[]
  tasks             Task[]
  schedules         Schedule[]
  artifacts         Artifact[]
  computers         Computer[]
  browserProfiles   BrowserProfile[]
}

model Conversation {
  id        String   @id @default(cuid())
  botId     String
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id          String   @id @default(cuid())
  conversationId String
  role        MessageRole
  content     String
  toolCalls   Json?
  createdAt   DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

enum MessageRole {
  user
  assistant
  system
  tool
}

model Memory {
  id          String   @id @default(cuid())
  botId       String
  userId      String
  content     String
  source      String?
  importance  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id          String              @id @default(cuid())
  botId       String
  title       String
  status      TaskStatus          @default(pending)
  input       Json
  result      Json?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  completedAt DateTime?
  bot         Bot                 @relation(fields: [botId], references: [id], onDelete: Cascade)
  approvals   Approval[]
  artifacts   Artifact[]
}

enum TaskStatus {
  pending
  running
  paused
  completed
  failed
  cancelled
}

model Approval {
  id          String       @id @default(cuid())
  taskId      String
  action      String
  target      String
  dataSummary String?
  status      ApprovalStatus @default(pending)
  decidedAt   DateTime?
  createdAt   DateTime     @default(now())
  task        Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

enum ApprovalStatus {
  pending
  approved
  denied
}

model Computer {
  id            String         @id @default(cuid())
  botId         String?
  userId        String?
  provider      String
  status        ComputerStatus @default(stopped)
  workspacePath String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  bot           Bot?           @relation(fields: [botId], references: [id], onDelete: SetNull)
  user          User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
}

enum ComputerStatus {
  stopped
  starting
  running
  sleeping
  error
}

model BrowserProfile {
  id              String       @id @default(cuid())
  botId           String
  name            String
  storageStatePath String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  bot             Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model Connector {
  id                   String     @id @default(cuid())
  userId               String
  type                 String
  credentialsEncrypted String
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Schedule {
  id             String     @id @default(cuid())
  botId          String
  cronExpression String
  timezone       String
  taskTemplate   Json
  enabled        Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  bot            Bot        @relation(fields: [botId], references: [id], onDelete: Cascade)
}

model Artifact {
  id          String   @id @default(cuid())
  botId       String
  taskId      String?
  filename    String
  mimeType    String
  sizeBytes   Int
  checksum    String
  storagePath String
  createdAt   DateTime @default(now())
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
}
